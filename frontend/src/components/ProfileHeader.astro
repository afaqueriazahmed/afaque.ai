---
// Professional Profile Header Component
---

<header class="profile-header">
  <div class="banner-container">
    <img src="/HIGGS-banner-16x9-white-bg-black-text.png" alt="Higgs Computing Banner" class="banner-image" />
  </div>
  
  <div class="profile-container">
    <div class="profile-content">
      <div class="profile-picture-wrapper">
        <img src="/ProfilePicture-HD.jpg" alt="Afaque Riaz Ahmed" class="profile-picture" />
      </div>
      
      <div class="profile-info">
        <h1 class="profile-name">Afaque Riaz Ahmed</h1>
        <p class="profile-tagline">Founder and CEO | Energy, Bitcoin, Blockchain and Fintech</p>
        <p class="profile-bio">
          A third-generation serial entrepreneur with a 20-year track record of setting up technology start-ups, with domain expertise ranging from Semiconductors, Telecommunications, Software, Technical and Higher Education, Blockchain/HPC and Public Advocacy.
        </p>
        
        <div class="profile-links">
          <a href="https://www.linkedin.com/in/afaqueriazahmed/" target="_blank" rel="noopener noreferrer" class="social-link linkedin">
            <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.722-2.004 1.418-.103.249-.129.597-.129.946v5.441h-3.554s.05-8.736 0-9.604h3.554v1.328c.481-.742 1.332-1.8 3.243-1.8 2.37 0 4.14 1.55 4.14 4.886v5.19zM5.337 8.855c-1.144 0-1.915-.758-1.915-1.71 0-.955.77-1.71 1.958-1.71 1.187 0 1.927.755 1.94 1.71 0 .952-.753 1.71-1.983 1.71zm1.581 11.597H3.635V9.242h3.283v11.21zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
            </svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .profile-header {
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    border-bottom: 1px solid #e0e0e0;
  }

  .banner-container {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .profile-content {
    display: flex;
    gap: 40px;
    align-items: flex-start;
    padding: 40px 0;
    flex-wrap: wrap;
  }

  .profile-picture-wrapper {
    flex-shrink: 0;
  }

  .profile-picture {
    width: 160px;
    height: 160px;
    border-radius: 12px;
    object-fit: cover;
    border: 4px solid white;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    margin-top: -80px;
  }

  .profile-info {
    flex: 1;
    min-width: 300px;
    padding-top: 20px;
  }

  .profile-name {
    font-size: 42px;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: #1a1a1a;
    letter-spacing: -0.5px;
  }

  .profile-tagline {
    font-size: 18px;
    font-weight: 600;
    color: #667eea;
    margin: 0 0 16px 0;
  }

  .profile-bio {
    font-size: 16px;
    line-height: 1.6;
    color: #555;
    margin: 0 0 24px 0;
    max-width: 600px;
  }

  .profile-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: white;
    border: 2px solid #667eea;
    border-radius: 8px;
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .social-link:hover {
    background: #667eea;
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
  }

  .social-icon {
    width: 18px;
    height: 18px;
  }

  .social-link.linkedin:hover {
    background: #0077b5;
    border-color: #0077b5;
  }

  @media (max-width: 768px) {
    .banner-container {
      height: 120px;
    }

    .profile-content {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
      padding: 20px 0;
    }

    .profile-picture {
      width: 120px;
      height: 120px;
      margin-top: -60px;
    }

    .profile-name {
      font-size: 32px;
    }

    .profile-tagline {
      font-size: 16px;
    }

    .profile-bio {
      font-size: 14px;
    }

    .profile-links {
      justify-content: center;
    }
  }
</style>
